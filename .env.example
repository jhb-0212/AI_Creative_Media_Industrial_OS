# 环境变量样例（复制为 .env 后填写真实值，真实密钥绝不入库）

# ---- 基础 ----
APP_ENV=development
APP_VERSION=2.0.5
LOG_LEVEL=INFO

# ---- 数据库 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_film_industrial
# 业务域数据库角色口令（统一一份；角色名由代码固定，不在此配置）。
# 迁移 c2d3e4f5a6b7 按域创建 svc_project_planning / svc_asset /
# svc_outbox_relay / svc_identity 四个角色，均为 LOGIN + NOBYPASSRLS。
POSTGRES_APP_PASSWORD=app_dev_password

# ---- Redis ----
REDIS_URL=redis://localhost:16379/0

# ---- 对象存储（S3 兼容）----
S3_ENDPOINT_URL=replace_me
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_BUCKET=ai-film-assets

# ---- Temporal ----
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233

# ---- 消息队列 ----
MQ_URL=amqp://guest:guest@localhost:5672/

# ---- 模型网关（双模式计费：USER_OWN_KEY / PLATFORM_PAID）----
MODEL_GATEWAY_BILLING_MODE=USER_OWN_KEY
MODEL_GATEWAY_API_KEY=replace_me

# ---- 可观测 ----
# 留空则禁用 OTLP 导出（优雅降级，不影响服务启动）；需要链路追踪时填入 Collector 地址，如 http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# 是否明文 gRPC 传输链路数据。默认 false（启用 TLS 加密）；仅本机/内网联调时才设 true
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=ai-film-industrial-platform

# ---- 密钥管理 ----
SECRET_MANAGER_PROVIDER=env

# ---------------------------------------------------------------------------
# 身份密钥边界（包 B4）
#
# 签发私钥（IDENTITY_PRIVATE_KEY_PEM）**只允许**出现在 IDENTITY_PROCESS_ROLE=issuer
# 的进程里。API 进程配置了私钥会直接拒绝启动——这是刻意的：私钥进 API 进程
# 等于"任何能 dump 内存的人都能伪造任意主体令牌"。
#
# API 进程只需验签公钥，二选一：
#   IDENTITY_PUBLIC_KEY_PEM=<公钥 PEM>
#   IDENTITY_JWKS_FILE=/run/secrets/identity-jwks.json
# 两者都不配也会拒绝启动（不做"临时生成密钥"兜底：重启后令牌全失效，
# 多副本之间互不认可，故障现象看起来像"令牌被篡改"）。
# ---------------------------------------------------------------------------
IDENTITY_PROCESS_ROLE=api
IDENTITY_PUBLIC_KEY_PEM=
IDENTITY_JWKS_FILE=
