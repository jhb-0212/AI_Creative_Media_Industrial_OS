# 环境变量样例（复制为 .env 后填写真实值，真实密钥绝不入库）

# ---- 基础 ----
APP_ENV=development
APP_VERSION=2.0.5
LOG_LEVEL=INFO

# ---- 数据库 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_film_industrial
# 应用角色（RLS 生效前提：非超级用户、NOBYPASSRLS，迁移自动创建）
POSTGRES_APP_USER=app_role
POSTGRES_APP_PASSWORD=app_dev_password

# ---- Redis ----
REDIS_URL=redis://localhost:16379/0

# ---- 对象存储（S3 兼容）----
S3_ENDPOINT_URL=replace_me
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_BUCKET=ai-film-assets

# ---- Temporal ----
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233

# ---- 消息队列 ----
MQ_URL=amqp://guest:guest@localhost:5672/

# ---- 模型网关（双模式计费：USER_OWN_KEY / PLATFORM_PAID）----
MODEL_GATEWAY_BILLING_MODE=USER_OWN_KEY
MODEL_GATEWAY_API_KEY=replace_me

# ---- 可观测 ----
# 留空则禁用 OTLP 导出（优雅降级，不影响服务启动）；需要链路追踪时填入 Collector 地址，如 http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# 是否明文 gRPC 传输链路数据。默认 false（启用 TLS 加密）；仅本机/内网联调时才设 true
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=ai-film-industrial-platform

# ---- 密钥管理 ----
SECRET_MANAGER_PROVIDER=env
