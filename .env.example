# 环境变量样例（复制为 .env 后填写真实值，真实密钥绝不入库）

# ---- 基础 ----
APP_ENV=development
APP_VERSION=2.0.5
LOG_LEVEL=INFO
# 进程角色（F05 进程密钥最小权限）：决定生产启动时校验哪一份必需密钥清单。
#   api                —— FastAPI 服务（默认）：持公钥验签，不持签发私钥
#   relay              —— Outbox 投递进程：不碰身份密钥，用 outbox_relay_role 连库
#   outbox_maintenance —— Outbox 运维 CLI：用 postgres 超级用户做 DDL
#   identity           —— 身份签发服务：持私钥+公钥签发令牌
# 各进程入口已显式声明自身角色（get_process_settings），通常无需在此覆盖；
# 仅当部署方式与默认进程入口不同时才显式设置。
# PROCESS_ROLE=api

# ---- 数据库 ----
# 本地验证实例 afs-step-feat @ 15444。**不是**生产 15432 / ai_film_verify。
# 同一实例上有两套互不通用的库，混用会制造「策略语义不符」的假红灯：
#   ai_film_api_tests     main 链 head c1a2b3d4e5f6，供 tests/unit 的 API/DB 用例
#   ai_film_industrial    分叉归属链（pending/feat-ownership），供归属闸门验证
# 测试库重建：CREATE DATABASE ai_film_api_tests; 然后
#   POSTGRES_DB=ai_film_api_tests ./.venv/Scripts/python.exe -m alembic upgrade head
POSTGRES_HOST=localhost
POSTGRES_PORT=15444
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replay_super_pw
POSTGRES_DB=ai_film_api_tests
# 应用角色（RLS 生效前提：非超级用户、NOBYPASSRLS，迁移自动创建）
POSTGRES_APP_USER=app_role
POSTGRES_APP_PASSWORD=app_dev_password
# Outbox Relay 专用角色（F03 数据所有权：Relay 只消费 outbox，不碰业务 schema）
POSTGRES_RELAY_USER=outbox_relay_role
POSTGRES_RELAY_PASSWORD=relay_dev_password
# 业务域角色（DATA-1 模块级角色隔离，迁移 8f3b2c1d4e5a 自动创建）：
# project_planning / asset_service 各自独立角色，只写自己的 schema。
POSTGRES_PROJECT_PLANNING_USER=project_planning_role
POSTGRES_PROJECT_PLANNING_PASSWORD=project_planning_dev_password
POSTGRES_ASSET_SERVICE_USER=asset_service_role
POSTGRES_ASSET_SERVICE_PASSWORD=asset_service_dev_password

# ---- 身份治理（决策 4：RS256 JWT）----
# 签发私钥：仅 identity 进程持有；API/Relay 生产启动不要求该项。
# 生产由密钥系统注入；本地开发用 `make dev-keys` 生成密钥对。
IDENTITY_PRIVATE_KEY_PEM=
# 验签公钥：可安全分发，API 进程生产启动要求该项（缺失即拒绝启动）。
IDENTITY_PUBLIC_KEY_PEM=
IDENTITY_ISSUER=ai-film-identity
IDENTITY_AUDIENCE=ai-film-api
# 身份进程（workers/identity）监听地址：对外提供 JWKS，与 API 分端口。
IDENTITY_HOST=0.0.0.0
IDENTITY_PORT=8100

# ---- Redis ----
# 本地验证实例把 6379 映射到宿主机；16379 是旧 compose 的映射，当前环境未监听。
# 配错端口时每个请求都要等满一次 connect_timeout 才降级：熔断会在连续失败后
# 短路，但前几次的代价仍然存在。
REDIS_URL=redis://localhost:6379/0

# ---- 限流后端熔断 ----
# 连续失败达阈值后短路（不再发网络包），冷却期满放一个半开探测。
# 0 表示关闭熔断。阈值每多 1 就多付一个完整的 socket_connect_timeout。
# RATE_LIMIT_CIRCUIT_FAILURE_THRESHOLD=3
# RATE_LIMIT_CIRCUIT_RECOVERY_SECONDS=30

# ---- 就绪探针（GET /readyz）----
# 探针是编排面高频读：缓存让探测频率与请求频率解耦，单飞避免过期瞬间并发穿透。
# 失败结果同样缓存——故障期探测最贵，不缓存会让探针把连接池压死。
# READINESS_CACHE_TTL_SECONDS=1
# READINESS_TIMEOUT_SECONDS=2

# ---- 对象存储（S3 兼容）----
S3_ENDPOINT_URL=replace_me
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_BUCKET=ai-film-assets

# ---- Temporal ----
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233

# ---- 消息队列 ----
MQ_URL=amqp://guest:guest@localhost:5672/

# ---- 模型网关（双模式计费：USER_OWN_KEY / PLATFORM_PAID）----
MODEL_GATEWAY_BILLING_MODE=USER_OWN_KEY
MODEL_GATEWAY_API_KEY=replace_me
# 留空表示「不接真网关」：生成 Worker 以诚实失败落终态，不伪造产物。
MODEL_GATEWAY_BASE_URL=
# 协议：openai_compatible（同步，POST {base}/images/generations）
#       comfyui（三段异步，POST /prompt → 轮询 /history → /view 取产物）
MODEL_GATEWAY_PROTOCOL=openai_compatible
# openai_compatible 下是模型 id；comfyui 下是「工作流标识」（模型由工作流决定）
MODEL_GATEWAY_DEFAULT_MODEL=

# ---- ComfyUI 协议专用（仅在 MODEL_GATEWAY_PROTOCOL=comfyui 时读取）----
# 工作流模板：在 ComfyUI 里用「导出 (API)」得到，不是「导出」。
MODEL_GATEWAY_COMFYUI_WORKFLOW_PATH=
# 提示词注入节点与输入名。必须显式指定——不指定就只能猜，猜错会产出与
# 意图无关的图且全程无错。
MODEL_GATEWAY_COMFYUI_PROMPT_NODE=
MODEL_GATEWAY_COMFYUI_PROMPT_FIELD=text
# 可选：负向提示词节点、产物节点（工作流有多个保存节点时必须指定）
MODEL_GATEWAY_COMFYUI_NEGATIVE_NODE=
MODEL_GATEWAY_COMFYUI_OUTPUT_NODE=
# 轮询间隔与总时限。总时限要大于最慢一张图的耗时，否则会误判超时并重复排队。
MODEL_GATEWAY_COMFYUI_POLL_INTERVAL_SECONDS=2.0
MODEL_GATEWAY_COMFYUI_JOB_TIMEOUT_SECONDS=900

# ---- 可观测 ----
# 留空则禁用 OTLP 导出（优雅降级，不影响服务启动）；需要链路追踪时填入 Collector 地址，如 http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# 是否明文 gRPC 传输链路数据。默认 false（启用 TLS 加密）；仅本机/内网联调时才设 true
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=ai-film-industrial-platform

# ---- 密钥管理 ----
SECRET_MANAGER_PROVIDER=env
