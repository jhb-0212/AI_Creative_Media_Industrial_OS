  "policies": [
    {
      "schemaname": "asset_service",
      "tablename": "asset_versions",
      "policyname": "tenant_isolation_asset_versions",
      "permissive": "PERMISSIVE",
      "roles": [
        "public"
      ],
      "cmd": "ALL",
      "qual": "((tenant_id = (NULLIF(current_setting('app.current_tenant_id'::text, true), ''::text))::uuid) AND (EXISTS ( SELECT 1\n   FROM project_planning.projects p\n  WHERE (((p.entity_id)::text = (asset_versions.project_id)::text) AND (p.tenant_id = asset_versions.tenant_id)))))",
      "with_check": null
    },
    {
      "schemaname": "asset_service",
      "tablename": "qc_reports",
      "policyname": "tenant_isolation_qc_reports",
      "permissive": "PERMISSIVE",
