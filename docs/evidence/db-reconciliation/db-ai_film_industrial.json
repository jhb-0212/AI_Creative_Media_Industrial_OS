        "public"
      ],
      "cmd": "ALL",
      "qual": "((tenant_id = (NULLIF(current_setting('app.current_tenant_id'::text, true), ''::text))::uuid) AND (EXISTS ( SELECT 1\n   FROM (asset_service.asset_versions a\n     JOIN project_planning.projects p ON ((((p.entity_id)::text = (a.project_id)::text) AND (p.tenant_id = a.tenant_id))))\n  WHERE (((a.entity_id)::text = (qc_reports.asset_version_id)::text) AND (a.tenant_id = qc_reports.tenant_id)))))",
      "with_check": null
