# ============================================================
# AI 影视工业化生产平台 API 镜像（多阶段构建）
# 目标：可运行 alembic 迁移 + uvicorn 的运行时镜像，交付层不携带构建工具。
#
# 三条硬约束（为什么必须这样写）：
# 1. builder 与 runtime 使用**同一个**基础镜像（ghcr 的 uv + Python 3.12 变体）。
#    uv 创建的虚拟环境在 pyvenv.cfg 里记录解释器的绝对路径（/usr/local）；
#    若 builder 用 uv 镜像、runtime 换成 python:slim，把 .venv 拷过去即断链
#    （venv 里的 python 指向一个 runtime 中不存在的解释器）。同源镜像才不会断。
# 2. runtime 删除 uv / uvx：交付层只留解释器、依赖与源码，减少可执行面。
# 3. 迁移不进镜像启动流程：由编排在 API 起来之前单独跑 `alembic upgrade head`，
#    避免多副本滚动发布时并发迁移。
# ============================================================

# ---------- Stage 1: 依赖解析与安装（uv + 锁文件，保证可复现） ----------
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

# 字节码预编译（缩短冷启动）与 copy 链接模式（跨层复制不依赖硬链接）。
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# 先只拷贝依赖清单与锁文件，最大化 layer cache 命中率。
# README.md 必须在场：pyproject 的 readme 字段在安装项目本体时会被读取。
COPY pyproject.toml uv.lock README.md ./

# --frozen：严格按 uv.lock 安装，任何漂移直接失败（不在构建期偷偷升级依赖）。
# --no-install-project：本层只装第三方依赖，源码变动不使该层缓存失效。
RUN uv sync --frozen --no-dev --no-install-project

# ---------- Stage 2: 源码与项目本体 ----------
COPY apps/ ./apps/
COPY services/ ./services/
COPY packages/ ./packages/
COPY workers/ ./workers/
COPY data/ ./data/
COPY contracts/ ./contracts/
COPY alembic.ini ./

RUN uv sync --frozen --no-dev

# ---------- Stage 3: 运行时镜像 ----------
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS runtime

# 非 root 运行（最小权限），并移除构建工具 uv。
RUN rm -f /usr/local/bin/uv /usr/local/bin/uvx \
    && useradd --create-home --uid 10001 appuser

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/apps ./apps
COPY --from=builder /app/services ./services
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/workers ./workers
COPY --from=builder /app/data ./data
COPY --from=builder /app/contracts ./contracts
COPY --from=builder /app/alembic.ini ./

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER appuser

# 就绪探针打 /readyz：真实探测数据库，而不是只看进程是否活着。
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/readyz', timeout=3)" || exit 1

EXPOSE 8000

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
