# 依赖锁文件：uv.lock 提交入库以保证可复现构建（见 README）。
# poetry.lock / Pipfile.lock 当前未采用，仍忽略。
poetry.lock
Pipfile.lock

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# 环境变量（密钥绝不入库）
.env
.env.*
!.env.example

# 密钥与凭证
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# 日志
*.log
logs/

